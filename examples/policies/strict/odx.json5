{
  version: 1,
  roles: { domain: ["domain", "domain/**"], adapters: ["adapters", "adapters/**"], app: ["app", "app/**"] },
  dependencies: {
    domain: { may_import: ["domain", "adapters", "core:*"], deny: ["core:os", "core:os/*", "core:net", "core:net/*", "core:sys/*"] },
    adapters: { may_import: ["domain", "adapters", "core:*"], deny: [] },
    app: { may_import: ["domain", "adapters", "app", "core:*"], deny: [] },
  },
  exclude: [".odx/**", "cases/**", "build/**"],
  errors: { types: ["Domain_Failure", "Storage_Failure"], structural: false },
  odin: { flags: [], forbidden_flags: [], required_flags: [], explicit_allocators: "all", version: "dev-2026-09" },
}
