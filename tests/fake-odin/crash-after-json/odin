#!/bin/sh
# On `check`, writes one valid compiler JSON document and then the assertion failure the compiler
# prints for an import cycle, and dies by SIGTRAP like the compiler does. The path is fixed so golden
# output doesn't depend on the temp dir.
. "$(dirname "$0")/../pass-through.sh"
cat >&2 <<JSON
{
	"error_count": 1,
	"errors": [
		{
			"type": "error",
			"pos": {
				"file": "/fake-odin/a.odin",
				"offset": 0,
				"line": 1,
				"column": 1,
				"end_column": 1
			},
			"msgs": [
				"Illegal declaration cycle of \`x\`"
			]
		}
	]
}
src/check_expr.cpp(5933): Assertion Failure: \`entity->type != nullptr\` x (Constant)
This is a compiler error. Please report this.
JSON
kill -TRAP $$
