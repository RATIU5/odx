// Prints `odx/universe.odin` for one compiler: the kind of every name the compiler declares itself,
// which odx reads from this table and never from the documentation packages at run time. `diff.sh`
// formats the output and compares it with the checked-in file.
// Usage: universe <odin root> <compiler version>
package universe

import "core:fmt"
import "core:odin/ast"
import "core:odin/parser"
import "core:odin/tokenizer"
import "core:os"
import "core:slice"
import "core:strings"

import "../../odx"

Table :: map[string]odx.Kind

// The parser can't read these from the pinned `base:builtin`: `typeid` is a keyword, the two string
// types are missing, and the procedures sit on or after lines it gives up on.
@(rodata)
BUILTIN_ADDITIONS := [?]odx.Universe_Entry {
	{"typeid", .Type},
	{"string16", .Type},
	{"cstring16", .Type},
	{"min", .Proc},
	{"max", .Proc},
	{"expand_values", .Proc},
	{"soa_zip", .Proc},
	{"soa_unzip", .Proc},
	{"unreachable", .Proc},
	{"raw_data", .Proc},
}

// The parser can't read the result `type/#soa[N]T` or the stray `)` of the two `simd` lines. The
// count is documented as returning `typeid` and returns an integer. The parameter's value is a type
// or a constant by the parameter it names, so its kind is `Unknown`. The last four are declared by
// the compiler and missing from the documentation, and `uses_are_covered` found them. Each kind
// was probed at the pin.
@(rodata)
INTRINSICS_ADDITIONS := [?]odx.Universe_Entry {
	{"soa_struct", .Type_Proc},
	{"simd_approx_recip", .Proc},
	{"simd_approx_recip_sqrt", .Proc},
	{"type_polymorphic_record_parameter_count", .Proc},
	{"type_polymorphic_record_parameter_value", .Unknown},
	{"Fast_Math_Flag", .Type},
	{"Fast_Math_Flags", .Type},
	{"simd_x86__MM_SHUFFLE", .Proc},
	{"objc_send", .Proc},
}

main :: proc() {
	os.exit(run())
}

run :: proc() -> int {
	if len(os.args) != 3 {
		fmt.eprintln("usage: universe <odin root> <compiler version>")
		return 2
	}
	root := strings.trim_right(os.args[1], "/")
	ok := true

	builtin_file, builtin_read := parse_documentation(root, "builtin")
	intrinsics_file, intrinsics_read := parse_documentation(root, "intrinsics")
	if !builtin_read || !intrinsics_read {
		return 1
	}
	builtin := builtin_kinds(builtin_file, &ok)
	for entry in BUILTIN_ADDITIONS {
		builtin[entry.name] = entry.kind
	}
	ok &= covers_source(builtin, builtin_file.src, "base:builtin")
	ok &= add_runtime_builtins(&builtin, root)

	intrinsics := intrinsics_kinds(intrinsics_file)
	for entry in INTRINSICS_ADDITIONS {
		intrinsics[entry.name] = entry.kind
	}
	ok &= covers_source(intrinsics, intrinsics_file.src, "base:intrinsics")
	for collection in odx.ODIN_CODE_DIRS {
		ok &= uses_are_covered(intrinsics, fmt.aprintf("%s/%s", root, collection))
	}
	if !ok {
		return 1
	}

	fmt.println(
		"// Generated by `mise run universe`, which also fails when this file differs from",
	)
	fmt.println(
		"// what the compiler's `base:builtin`, `base:runtime` and `base:intrinsics` give.",
	)
	fmt.println("// Never edited by hand.")
	fmt.println("package odx")
	fmt.println()
	fmt.println("@(rodata)")
	fmt.println("UNIVERSES := [?]Universe {")
	fmt.println("\t{")
	fmt.printfln("\t\tcompiler = %q,", os.args[2])
	print_table("builtin", builtin)
	print_table("intrinsics", intrinsics)
	fmt.println("\t},")
	fmt.println("}")
	return 0
}

print_table :: proc(field: string, table: Table) {
	names, _ := slice.map_keys(table)
	slice.sort(names)
	fmt.printfln("\t\t%s = {{", field)
	for name in names {
		fmt.printfln("\t\t\t{{%q, .%v}},", name, table[name])
	}
	fmt.println("\t\t},")
}

// `base:builtin` and `base:intrinsics` document what the compiler declares, in Odin the parser
// reads only in part. It stops at their reserved package names, and it gives up on some lines, so
// the file comes back with whatever it could read.
parse_documentation :: proc(root, name: string) -> (file: ^ast.File, read: bool) {
	path := fmt.aprintf("%s/base/%s/%s.odin", root, name, name)
	data, err := os.read_entire_file(path, context.allocator)
	if err != nil {
		fmt.eprintfln("universe: %s: %s", path, os.error_string(err))
		return nil, false
	}
	src, _ := strings.replace(
		string(data),
		fmt.aprintf("package %s", name),
		fmt.aprintf("package %s_doc", name),
		1,
	)
	p := parser.default_parser()
	p.warn = nil
	p.err = proc(pos: tokenizer.Pos, msg: string, args: ..any) {}
	file = ast.new(ast.File, tokenizer.Pos{}, tokenizer.Pos{})
	file.src = src
	file.fullpath = path
	parser.parse_file(&p, file)
	return file, true
}

// A lowercase name declared as itself is a type, `type_of` gives a type, any other procedure or
// group is a procedure, an alias takes the kind of its target, and the rest are values.
builtin_kinds :: proc(file: ^ast.File, ok: ^bool) -> Table {
	table := make(Table)
	aliases := make(map[string]string)
	for stmt in file.decls {
		decl := stmt.derived.(^ast.Value_Decl) or_continue
		for name_expr, i in decl.names {
			ident := name_expr.derived.(^ast.Ident) or_continue
			name := ident.name
			if i >= len(decl.values) {
				continue
			}
			#partial switch value in decl.values[i].derived {
			case ^ast.Proc_Lit:
				table[name] = .Type_Proc if name == "type_of" else .Proc
			case ^ast.Proc_Group:
				table[name] = .Proc
			case ^ast.Ident:
				switch {
				case value.name != name:
					aliases[name] = value.name
				case name != "nil" && name[0] >= 'a' && name[0] <= 'z':
					table[name] = .Type
				case:
					table[name] = .Value
				}
			case:
				table[name] = .Value
			}
		}
	}
	for name, target in aliases {
		kind, known := table[target]
		if !known {
			fmt.eprintfln(
				"universe: base:builtin: '%s' is an alias of '%s', which has no kind",
				name,
				target,
			)
			ok^ = false
			continue
		}
		table[name] = kind
	}
	return table
}

// The `@(builtin)` declarations of `base:runtime` are ordinary Odin, so odx's own loader gives
// their kinds, with the names of `base:builtin` as its universe.
add_runtime_builtins :: proc(builtin: ^Table, root: string) -> (ok: bool) {
	dir, dir_err := os.get_absolute_path(fmt.aprintf("%s/base/runtime", root), context.allocator)
	if dir_err != nil {
		fmt.eprintfln("universe: %s/base/runtime: %s", root, os.error_string(dir_err))
		return false
	}
	entries := make([dynamic]odx.Universe_Entry)
	for name, kind in builtin {
		append(&entries, odx.Universe_Entry{name, kind})
	}
	resolver: odx.Resolver
	odx.resolver_init(&resolver, root, nil, {builtin = entries[:]}, context.allocator)
	kinds := odx.package_symbols(&resolver, dir)

	files, read_err := os.read_directory_by_path(dir, -1, context.allocator)
	if read_err != nil {
		fmt.eprintfln("universe: %s: %s", dir, os.error_string(read_err))
		return false
	}
	ok = true
	for info in files {
		if !strings.has_suffix(info.name, ".odin") {
			continue
		}
		data, err := os.read_entire_file(info.fullpath, context.allocator)
		if err != nil {
			fmt.eprintfln("universe: %s: %s", info.fullpath, os.error_string(err))
			ok = false
			continue
		}
		file, failure := odx.parse_source(string(data), context.allocator)
		if failure != nil {
			continue
		}
		names := make([dynamic]string)
		for stmt in file.decls {
			collect_builtin_names(stmt, &names)
		}
		for name in names {
			kind := kinds[name]
			previous, declared := builtin[name]
			switch {
			case kind == .Unknown:
				fmt.eprintfln("universe: base:runtime: '%s' has no kind", name)
				ok = false
			case declared && previous != kind:
				fmt.eprintfln(
					"universe: '%s' is %v in base:builtin and %v in base:runtime",
					name,
					previous,
					kind,
				)
				ok = false
			case:
				builtin[name] = kind
			}
		}
	}
	return
}

collect_builtin_names :: proc(stmt: ^ast.Stmt, names: ^[dynamic]string) {
	if stmt == nil {
		return
	}
	#partial switch n in stmt.derived {
	case ^ast.Value_Decl:
		for attribute in n.attributes {
			for elem in attribute.elems {
				ident := elem.derived.(^ast.Ident) or_continue
				if ident.name != "builtin" {
					continue
				}
				for name in n.names {
					if declared, is_ident := name.derived.(^ast.Ident); is_ident {
						append(names, declared.name)
					}
				}
			}
		}
	case ^ast.When_Stmt:
		collect_builtin_names(n.body, names)
		collect_builtin_names(n.else_stmt, names)
	case ^ast.Block_Stmt:
		for inner in n.stmts {
			collect_builtin_names(inner, names)
		}
	}
}

// A procedure without a body that returns a type gives a type, any other procedure is a procedure,
// and a type expression is a type. The documentation writes the result as `typeid` or as `type`.
// `covers_source` reports a declaration that is neither.
intrinsics_kinds :: proc(file: ^ast.File) -> Table {
	table := make(Table)
	for stmt in file.decls {
		decl := stmt.derived.(^ast.Value_Decl) or_continue
		for name_expr, i in decl.names {
			ident := name_expr.derived.(^ast.Ident) or_continue
			if i >= len(decl.values) {
				continue
			}
			value := odx.unwrap_expr(decl.values[i])
			lit, is_proc := value.derived.(^ast.Proc_Lit)
			switch {
			case is_proc:
				table[ident.name] =
					.Type_Proc if lit.body == nil && returns_type(lit.type) else .Proc
			case odx.is_type_expr(value):
				table[ident.name] = .Type
			}
		}
	}
	return table
}

returns_type :: proc(type: ^ast.Proc_Type) -> bool {
	if type.results == nil || len(type.results.list) != 1 || type.results.list[0].type == nil {
		return false
	}
	#partial switch result in type.results.list[0].type.derived {
	case ^ast.Typeid_Type:
		return true
	case ^ast.Ident:
		return result.name == "type" || result.name == "typeid"
	}
	return false
}

// Fails for a name the source declares at the start of a line when the table lacks it, or when the
// line declares a procedure and the table says otherwise. Both are how a line the parser gave up on
// shows, and an addition settles each. `Unknown` is an addition's way to say a procedure's calls
// have no one kind.
covers_source :: proc(table: Table, src, label: string) -> (ok: bool) {
	ok = true
	rest := src
	for line in strings.split_lines_iterator(&rest) {
		separator := strings.index(line, "::")
		if separator <= 0 {
			continue
		}
		name := strings.trim_right_space(line[:separator])
		if !is_identifier(name) {
			continue
		}
		kind, known := table[name]
		is_proc := strings.has_prefix(strings.trim_left_space(line[separator + 2:]), "proc")
		switch {
		case !known:
			fmt.eprintfln("universe: %s: the table has no kind for '%s'", label, name)
			ok = false
		case is_proc && kind != .Proc && kind != .Type_Proc && kind != .Unknown:
			fmt.eprintfln(
				"universe: %s: '%s' is a procedure, and the table has %v",
				label,
				name,
				kind,
			)
			ok = false
		}
	}
	return
}

is_identifier :: proc(text: string) -> bool {
	for i in 0 ..< len(text) {
		switch text[i] {
		case 'a' ..= 'z', 'A' ..= 'Z', '_':
		case '0' ..= '9':
			if i == 0 {
				return false
			}
		case:
			return false
		}
	}
	return text != ""
}

// Fails for an `intrinsics.name` that code under `dir` uses and the table lacks, which is how a name
// the compiler declares and the documentation omits shows. Comment lines don't count.
uses_are_covered :: proc(table: Table, dir: string) -> (ok: bool) {
	PREFIX :: "intrinsics."
	entries, err := os.read_directory_by_path(dir, -1, context.allocator)
	if err != nil {
		fmt.eprintfln("universe: %s: %s", dir, os.error_string(err))
		return false
	}
	ok = true
	for entry in entries {
		if entry.type == .Directory {
			ok &= uses_are_covered(table, entry.fullpath)
			continue
		}
		if !strings.has_suffix(entry.name, ".odin") {
			continue
		}
		data, read_err := os.read_entire_file(entry.fullpath, context.allocator)
		if read_err != nil {
			fmt.eprintfln("universe: %s: %s", entry.fullpath, os.error_string(read_err))
			ok = false
			continue
		}
		rest := string(data)
		for line in strings.split_lines_iterator(&rest) {
			if strings.has_prefix(strings.trim_left_space(line), "//") {
				continue
			}
			text := line
			for {
				at := strings.index(text, PREFIX)
				if at < 0 {
					break
				}
				is_whole_word := at == 0 || !is_identifier(text[at - 1:at])
				text = text[at + len(PREFIX):]
				end := 0
				for end < len(text) && is_identifier(text[:end + 1]) {
					end += 1
				}
				name := text[:end]
				if is_whole_word && name != "" && name not_in table {
					fmt.eprintfln(
						"universe: %s uses intrinsics.%s, and the table has no kind for it",
						entry.fullpath,
						name,
					)
					ok = false
				}
			}
		}
		delete(data)
	}
	return
}
