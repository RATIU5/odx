// Stage 0 contract: one package per executing rule, a fires file and a silent file each.
// The findings on this tree must stay byte-identical through CUT_IMPR Stages 1-3.
{
  version: 1,
  roles: {
    pure: ["allocators_r1", "dependencies_r2", "dependencies_r3", "dependencies_r4"],
    edge: ["errors_r3", "errors_r5"],
  },
  dependencies: {
    pure: { may_import: ["pure", "core:*"] },
    edge: { may_import: ["pure", "edge", "core:*"] },
  },
  odin: { flags: ["-vet", "-warnings-as-errors"] },
}
