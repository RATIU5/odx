{
  name: "errors",
  summary: "Typed errors, @(require_results), or_return; never discard a failure",
  tags: ["errors", "results", "or_return", "require_results"],
  aliases: ["error handling", "failure", "fallible", "boolean result", "ok flag"],
  example_questions: [
    "how do I return failures from a proc",
    "should this return a bool or an error",
    "how do I propagate an error to the caller",
  ],
  applies_to: { roles: ["pure", "service", "edge"] },
  related: ["layering"],
  example_roles: { "example/core": "pure" },
  rules: [
    {
      id: "R1",
      class: "errors_typed_result",
      statement: "Exported procedures that can fail return an error type as the last result, not a bool.",
      why: "A bool, and equally a single universal error type, is 'all the same degenerate value: error or not... a fancy boolean'. Callers cannot branch on it or report it.",
      severity: "error",
      instead_of: "Returning (T, bool) or an ok flag from a procedure with more than one failure mode.",
      evidence: "'All the same degenerate value: error or not... a fancy boolean' (Exceptions, 2018); callers cannot branch on or report a bool.",
      cost: "An Error type per package to declare and keep exhaustive.",
      blocking: false,
      check: { kind: "manual" },
    },
    {
      id: "R2",
      class: "errors_one_type_per_package",
      statement: "Each package declares one Error enum or union; no string or any errors.",
      why: "'Having an error value type defined per package is absolutely fine (and ergonomic too)'. A typed error is exhaustively switchable and greppable; strings and any are neither.",
      severity: "error",
      instead_of: "Propagating string, any, or another package's error type across the package boundary.",
      evidence: "'Having an error value type defined per package is absolutely fine (and ergonomic too)'; strings and any are neither switchable nor greppable.",
      cost: "Translating foreign errors at the boundary is extra code; a union is needed when several dependencies are wrapped.",
      blocking: false,
      check: { kind: "manual" },
    },
    {
      id: "R3",
      class: "errors_require_results",
      statement: "Exported procedures whose last result is an error type carry @(require_results).",
      why: "Only the attribute makes the compiler reject a discarded failure; -vet does not (`x, _ := f()` and a bare `g()` both pass). This is odx's convention, not a documented Odin one.",
      severity: "error",
      instead_of: "Trusting callers to check the error result by convention.",
      evidence: "`x, _ := f()` and a bare `g()` both exit 0 under -vet -vet-cast on dev-2026-09; only the attribute makes the compiler reject the drop.",
      cost: "Every fallible exported proc carries the attribute; callers must handle or explicitly discard with `_ =`.",
      blocking: true,
      check: { kind: "require_attribute", attribute: "require_results", on: "exported_procs", result_type_suffix: ["Error"] },
    },
    {
      id: "R4",
      class: "errors_or_return",
      statement: "Handle an error where it occurs when you can; when a package's operations genuinely chain, prefer or_return over hand-written `if err != nil { return }`.",
      why: "'You make your mess; you clean it.' Local handling is the default; or_return is a per-package tool ('when a package needs it, it REALLY needs it') that keeps a chained happy path linear.",
      severity: "warning",
      instead_of: "Blanket or_return everywhere, or blanket hand-written if err != nil blocks.",
      evidence: "'You make your mess; you clean it' (Exceptions); 'when a package needs it, it REALLY needs it' (Value Propagation Part 2).",
      cost: "A judgement per package about whether its operations chain; advisory, so a reviewer decides.",
      blocking: false,
      check: { kind: "manual" },
    },
  ],
}
