{
  name: "allocators",
  summary: "Explicit allocator parameters in pure code; each allocation's lifetime is chosen at the call site",
  tags: ["allocators", "memory", "arena", "defer", "leaks"],
  aliases: ["memory management", "allocation", "context.allocator"],
  example_questions: [
    "who frees this slice",
    "should this proc take an allocator parameter",
    "how do I avoid leaks in tests",
  ],
  applies_to: { roles: ["pure", "service"] },
  related: ["errors", "layering"],
  example_roles: { "example/core": "pure" },
  rules: [
    {
      id: "R1",
      class: "allocators_explicit_tag",
      statement: "Every file in a pure or service package starts with `#+vet explicit-allocators`.",
      why: "So each allocation's lifetime is chosen at the call site by a specific allocator rather than inherited implicitly; the compiler then rejects make/new/append that forgot to say. context.temp_allocator scratch use and files that set the context are exempt: context exists precisely to be intercepted.",
      severity: "error",
      instead_of: "Relying on the implicit context.allocator at every call site and auditing leaks after the fact.",
      evidence: "`make([dynamic]string)` with no allocator argument compiles clean under -vet; only the file tag makes the compiler reject it.",
      cost: "Every make/new/append in a tagged file names an allocator; scratch code gets wordier.",
      blocking: true,
      check: { kind: "vet_tag" },
    },
    {
      id: "R2",
      class: "allocators_owner_parameter",
      statement: "A procedure that allocates takes `allocator := context.allocator` as its last parameter and documents who frees.",
      why: "Callers pick arenas or trackers ('a good API offers a way to specify the allocator to use'); the doc comment says who frees because a signature cannot. Inside a tagged file the default is unreachable from other tagged files, so it serves untagged callers; R1 and R2 do not conflict.",
      severity: "error",
      instead_of: "Allocating internally with whatever context.allocator holds and documenting nothing.",
      evidence: "'A good API offers a way to specify the allocator to use'; callers using arenas or tracking allocators in tests cannot otherwise reach the allocation.",
      cost: "One extra parameter on every allocating procedure, and a doc comment the tool can only check for existence.",
      blocking: false,
      check: { kind: "manual" },
    },
    {
      id: "R3",
      class: "allocators_sanitized_tests",
      statement: "Tests run with -sanitize:address and -define:ODIN_TEST_FAIL_ON_BAD_MEMORY=true.",
      why: "Leaks are only WARN by default; the define turns them into failures.",
      severity: "error",
      instead_of: "Running tests with the default runner settings, where a leak is a WARN line nobody reads.",
      evidence: "-define:ODIN_TEST_FAIL_ON_BAD_MEMORY=true turns tracking-allocator findings into failures; without it the suite is green with leaks.",
      cost: "Slower tests under -sanitize:address, and a macOS toolchain that needs LLVM clang.",
      blocking: false,
      check: { kind: "manual" },
    },
  ],
}
