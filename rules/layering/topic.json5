{
  name: "layering",
  summary: "Package roles (pure, service, edge) fix who may import whom, hold globals, and touch foreign",
  tags: ["layering", "roles", "imports", "globals", "foreign", "architecture"],
  aliases: ["package structure", "dependencies", "import rules", "modules"],
  example_questions: [
    "which package should this code go in",
    "can a core package import os",
    "where do foreign bindings live",
  ],
  applies_to: { roles: ["pure", "service", "edge"] },
  related: ["errors"],
  example_roles: { "example/core": "pure", "example/platform": "edge" },
  rules: [
    {
      id: "R1",
      class: "layering_unroled_package",
      statement: "Every package directory maps to exactly one role in odx.json5.",
      why: "Unmapped code has no rules; doubly mapped code has contradictory ones.",
      severity: "error",
      instead_of: "Leaving package directories unmapped so the role-scoped rules silently do not apply to them.",
      evidence: "An unroled package matches no layering entry and no applies_to list, so every role-scoped check is vacuous for it.",
      cost: "Every new package directory needs one line in odx.json5.",
      blocking: true,
      check: { kind: "path_role" },
    },
    {
      id: "R2",
      class: "layering_forbidden_import",
      statement: "A package imports only what its role's may_import allows; pure never imports os, net, or foreign.",
      why: "Dependencies only flow down. A pure package that reaches for I/O stops being testable without the world.",
      severity: "error",
      instead_of: "Letting any package import anything and discovering the OS dependency in a test that needs the world.",
      evidence: "The compiler forbids cycles but says nothing about direction; a pure package that imports core:os cannot be tested without it.",
      cost: "A may_import list per role to maintain; a real graph that does not fit the roles needs explicit entries.",
      blocking: true,
      check: { kind: "banned_import", from: "layering.may_import" },
    },
    {
      id: "R3",
      class: "layering_hidden_state",
      statement: "No mutable package-level variables in pure or service packages; pass state as a parameter.",
      why: "'Globals and/or thread local variables... are just dreadful solutions.' Hidden state makes two calls with the same arguments give different answers. Edge packages own the process and are the one place a global may live.",
      severity: "error",
      instead_of: "Package-level state read and written from several procedures.",
      evidence: "'Globals and/or thread local variables... are just dreadful solutions'; two calls with the same arguments give different answers.",
      cost: "State becomes a parameter or a struct the caller owns; edge packages are exempt.",
      blocking: true,
      check: { kind: "banned_construct", construct: "mutable_global", roles: ["pure", "service"] },
    },
    {
      id: "R4",
      class: "layering_foreign_placement",
      statement: "foreign imports and foreign blocks live only in edge packages.",
      why: "The FFI boundary is where the ABI and calling convention change; keep it in one place. This is a mechanical justification, not a taxonomic one.",
      severity: "error",
      instead_of: "Foreign blocks wherever the binding is first needed.",
      evidence: "A foreign block changes the ABI and calling convention at that point; scattered blocks mean scattered unsafety.",
      cost: "A dedicated edge package per native dependency.",
      blocking: true,
      check: { kind: "banned_construct", construct: "foreign_decl", except_roles: ["edge"] },
    },
  ],
}
