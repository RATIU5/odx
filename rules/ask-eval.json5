// Labelled questions for `odx ask --eval` (10b). Paraphrased so they do not copy tag words.
[
  { q: "what should a proc give back when it cannot do its job", expected_ids: ["errors"] },
  { q: "is a boolean ok for signalling that opening the file went wrong", expected_ids: ["errors"] },
  { q: "the caller keeps dropping the second return value, how do I make the compiler complain", expected_ids: ["errors"] },
  { q: "pass a failure up to whoever called me", expected_ids: ["errors"] },
  { q: "one enum for everything that can go wrong in a package", expected_ids: ["errors"] },
  { q: "should I return a string describing the problem", expected_ids: ["errors"] },
  { q: "which attribute forces callers to use the result", expected_ids: ["errors"] },
  { q: "recover locally or bubble it up", expected_ids: ["errors"] },
  { q: "discarding a failure silently", expected_ids: ["errors"] },
  { q: "how to model something that can fail as a return type", expected_ids: ["errors"] },
  { q: "which directory does this new module belong in", expected_ids: ["layering"] },
  { q: "may the math package read files", expected_ids: ["layering"] },
  { q: "where should C bindings live", expected_ids: ["layering"] },
  { q: "package level variable that changes at runtime", expected_ids: ["layering"] },
  { q: "who is allowed to depend on whom", expected_ids: ["layering"] },
  { q: "core code reaching for the network", expected_ids: ["layering"] },
  { q: "hidden state makes the same call return different answers", expected_ids: ["layering"] },
  { q: "every directory needs a role in the config", expected_ids: ["layering"] },
  { q: "keep the FFI boundary in one place", expected_ids: ["layering"] },
  { q: "can a service package import an edge package", expected_ids: ["layering"] },
  { q: "who owns the slice this proc returns and who releases it", expected_ids: ["allocators"] },
  { q: "make and append without saying where the memory comes from", expected_ids: ["allocators"] },
  { q: "detecting leaks when running the tests", expected_ids: ["allocators"] },
  { q: "file tag that makes the compiler reject implicit context allocation", expected_ids: ["allocators"] },
  { q: "should the caller pick the arena", expected_ids: ["allocators"] },
  { q: "last parameter of a proc that builds a dynamic array", expected_ids: ["allocators"] },
  { q: "address sanitizer flag for the test runner", expected_ids: ["allocators"] },
  { q: "defer the free right after the make", expected_ids: ["allocators"] },
  { q: "tracking allocator in tests", expected_ids: ["allocators"] },
  { q: "why does explicit allocators matter for pure packages", expected_ids: ["allocators"] },
  { q: "a pure package that opens files and returns a bool on failure", expected_ids: ["layering", "errors"] },
